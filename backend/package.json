{
  "name": "backend",
  "version": "1.0.0",
  "description": "FinShield Backend Service & Test Runner",
  "scripts": {
    "test": "node ../scripts/test-runner.js",
    "test:all": "node ../scripts/test-runner.js",
    "test:status": "node ../scripts/test-runner.js --status",
    "test:health": "node ../scripts/test-runner.js --layer=health",
    "test:models": "node ../scripts/test-runner.js --layer=models",
    "test:engines": "node ../scripts/test-runner.js --layer=engines",
    "test:api": "node ../scripts/test-runner.js --layer=api",
    "test:verbose": "node ../scripts/test-runner.js -v",
    "test:pytest": "python -m pytest tests -v",
    "start": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "keywords": [
    "finshield",
    "fastapi",
    "pytest"
  ],
  "author": "FinShield Engineering Team",
  "license": "MIT"
}
